# Environment Configuration Example
# Copy to .env and adjust as needed

ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:8000","http://localhost:8000"]

# ML Model Configuration
MODEL_DIR=models
MODEL_FILENAME=fraud_detector_xgb.joblib
PREPROCESSOR_FILENAME=preprocessor.joblib
METRICS_FILENAME=model_metrics.json

# Decision Thresholds
FRAUD_PROBABILITY_THRESHOLD=0.35
REVIEW_PROBABILITY_THRESHOLD=0.20
