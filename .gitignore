# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments & Virtual Envs
.env
.venv
env/
venv/
ENV/
build/
dist/
*.egg-info/

# Unit test / coverage reports
.pytest_cache/
.coverage
htmlcov/

# Data & Datasets (Preserve directory structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Serialized Model Artifacts larger than 50MB
*.pkl
*.h5

# IDE specific files
.vscode/
.idea/
*.swp
