# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments & Virtual Envs
.env
.env.local
.env.*.local
frontend/.env
backend/.env
.venv
node_modules/
frontend/node_modules/
.next/
env/
venv/
ENV/
build/
dist/
