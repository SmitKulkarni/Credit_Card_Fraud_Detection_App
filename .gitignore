.pytest_cache/
.coverage
htmlcov/

# Databases & SQLite
*.db
*.sqlite3
backend/data/*.db

# Data & Datasets (Preserve directory structure via .gitkeep)
backend/data/raw/*
!backend/data/raw/.gitkeep
backend/data/processed/*
!backend/data/processed/.gitkeep

# Serialized Model Artifacts larger than 50MB
*.pkl
*.h5

# IDE specific files
.vscode/
.idea/
*.swp

